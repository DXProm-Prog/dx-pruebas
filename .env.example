PORT=4000

# Brevo (para enviar correos vía API HTTPS, ya que Render bloquea SMTP
# en el plan gratuito). Ver README para cómo obtener estos datos.
BREVO_API_KEY=tu-api-key-de-brevo
SENDER_EMAIL=tu-correo-verificado@gmail.com
SENDER_NAME=Democracia por Promedio

# URL pública de tu app visual (GitHub Pages), usada para incluir el link
# directo en los correos que se envían. Ejemplo:
FRONTEND_URL=https://dxprom-prog.github.io/dx-pruebas/
