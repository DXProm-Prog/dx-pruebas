PORT=4000

# Configuración de correo para avisar al administrador cuando alguien pide
# unirse a su grupo. Si dejas esto vacío, la app funciona igual, solo no
# manda correos.
#
# Ejemplo usando Gmail (necesitas una "contraseña de aplicación", ver README):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion
SMTP_FROM=tu-correo@gmail.com
